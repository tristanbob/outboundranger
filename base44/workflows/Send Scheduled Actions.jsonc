{
  "name": "Send Scheduled Actions",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_scheduled_actions",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_due": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendScheduledActions"
          },
          "then": "end",
          "x-base44": {
            "title": "Send due actions",
            "description": "Queued messages whose time has come"
          }
        }
      }
    ]
  },
  "description": "Every hour, sends any approved agent action whose scheduled send time has arrived.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/Denver",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}