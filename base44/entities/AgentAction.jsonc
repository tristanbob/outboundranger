{
  "name": "AgentAction",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization this action belongs to"
    },
    "lead_id": {
      "type": "string"
    },
    "lead_name": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "cold_outreach",
        "follow_up",
        "share_content",
        "intro_request",
        "meeting_request"
      ]
    },
    "channel": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "reasoning": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "expected_effect": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "high"
      ],
      "default": "low"
    },
    "confidence": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "executed",
        "completed",
        "rejected"
      ],
      "default": "proposed"
    },
    "mode": {
      "type": "string",
      "enum": [
        "propose",
        "autopilot"
      ],
      "default": "propose"
    },
    "was_edited": {
      "type": "boolean",
      "default": false
    },
    "original_message": {
      "type": "string"
    },
    "decision_reason": {
      "type": "string",
      "description": "Why the user approved/rejected/edited"
    },
    "applied_memory_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Memory entries the agent applied when drafting this action \u2014 used to credit or retire them"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "reply",
        "meeting_booked",
        "conversion",
        "no_response",
        "unsubscribe"
      ]
    },
    "outcome_details": {
      "type": "string"
    },
    "prediction_hit": {
      "type": "string",
      "enum": [
        "yes",
        "partial",
        "no"
      ],
      "description": "Did the real outcome match the agent's expected effect"
    },
    "reply_read": {
      "type": "string",
      "description": "The GTM agent's assessment of what the customer's reply actually means"
    },
    "reply_objection": {
      "type": "string",
      "description": "The objection or blocker the customer raised, if any"
    },
    "reply_interest": {
      "type": "string",
      "enum": [
        "increased",
        "unchanged",
        "decreased"
      ],
      "description": "How the reply shifted the lead's interest"
    },
    "recommended_next_move": {
      "type": "string",
      "description": "The next move the agent recommends based on the reply"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "action_type",
    "message"
  ]
}