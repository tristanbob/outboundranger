{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "segment": {
      "type": "string",
      "enum": [
        "startup",
        "smb",
        "mid_market",
        "enterprise"
      ],
      "default": "smb"
    },
    "signal": {
      "type": "string",
      "description": "Why this lead is an opportunity right now"
    },
    "signal_strength": {
      "type": "number",
      "description": "0-100"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "replied",
        "meeting_booked",
        "converted",
        "unsubscribed"
      ],
      "default": "new"
    },
    "persona": {
      "type": "string",
      "description": "Personality traits used by the simulated customer agent"
    },
    "dossier": {
      "type": "string",
      "description": "Durable facts the agent has learned about THIS customer: their objection, timeline, buying committee, what we already tried"
    },
    "dossier_do_not_repeat": {
      "type": "string",
      "description": "Angles already used on this customer that must not be repeated"
    },
    "dossier_updated": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "company"
  ]
}